# Copy this to .env and fill in values before running.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

PORT=8080

# One secret per peer — must be different, >= 32 chars each
PAIR_SECRET_A=replace_me_with_32_plus_chars_for_peer_a
PAIR_SECRET_B=replace_me_with_32_plus_chars_for_peer_b

# Shared secret between signaling server and coturn (RFC 5766 REST API)
TURN_STATIC_AUTH_SECRET=replace_me_with_32_plus_chars_for_turn

# Public hostname/port of your TURN server (ngrok TCP tunnel during dev)
# e.g. PUBLIC_TURN_HOST=4.tcp.ngrok.io
PUBLIC_TURN_HOST=your.turn.host.here
PUBLIC_TURN_PORT=3478
TURNS_TLS_PORT=5349

# OR override everything by handing the client a raw ICE-servers list.
# Use this when you want to plug in a third-party TURN provider (Metered, Cloudflare, etc.).
# Must be valid JSON; if set, the PUBLIC_TURN_* settings above are ignored.
# Example (Metered.ca free tier):
# ICE_SERVERS_JSON=[{"urls":"stun:stun.relay.metered.ca:80"},{"urls":"turn:standard.relay.metered.ca:80","username":"YOUR_USER","credential":"YOUR_PASS"},{"urls":"turn:standard.relay.metered.ca:80?transport=tcp","username":"YOUR_USER","credential":"YOUR_PASS"},{"urls":"turn:standard.relay.metered.ca:443","username":"YOUR_USER","credential":"YOUR_PASS"},{"urls":"turns:standard.relay.metered.ca:443?transport=tcp","username":"YOUR_USER","credential":"YOUR_PASS"}]
#ICE_SERVERS_JSON=
