# Copy this to .env and fill in values before running.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

PORT=8080

# One secret per peer — must be different, >= 32 chars each
PAIR_SECRET_A=replace_me_with_32_plus_chars_for_peer_a
PAIR_SECRET_B=replace_me_with_32_plus_chars_for_peer_b

# ── HTTPS domain (production only) ───────────────────────────────────────────
# Used by the Caddyfile to provision a Let's Encrypt TLS cert automatically.
# Use <vm-public-ip>.nip.io for zero-DNS setup (e.g. 34.56.78.90.nip.io),
# or a real domain with an A record pointing at the VM's public IP.
APP_DOMAIN=your.domain.or.ip.nip.io

# ── Self-hosted coturn (primary — runs alongside the app on the same VM) ─────
# Shared secret between the signaling server and coturn (RFC 5766 REST API).
TURN_STATIC_AUTH_SECRET=replace_me_with_32_plus_chars_for_turn
# The VM's PUBLIC IP address — used both as coturn's --external-ip (so it
# advertises a routable relay address) and as the TURN host handed to
# clients. Must NOT be localhost/127.0.0.1 in production.
PUBLIC_TURN_HOST=your.oracle.vm.public.ip
PUBLIC_TURN_PORT=3478
TURNS_TLS_PORT=5349

# ── Cloudflare Realtime TURN (alternative — no coturn container needed) ──────
# Get a key pair from: Cloudflare Dashboard → Realtime → TURN → Create TURN keys.
# When set, this takes priority over the self-hosted coturn config above —
# the server fetches short-lived credentials from the Cloudflare API on each
# /ice-config request instead of using coturn.
#CLOUDFLARE_TURN_KEY_ID=your_cloudflare_turn_key_id
#CLOUDFLARE_TURN_KEY_SECRET=your_cloudflare_turn_key_secret

# ── Raw ICE-servers override (highest priority) ───────────────────────────────
# If set, overrides everything above. Must be valid JSON array of RTCIceServer objects.
#ICE_SERVERS_JSON=
