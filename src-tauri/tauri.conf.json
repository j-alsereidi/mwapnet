{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "mwapnet",
  "version": "0.1.0",
  "identifier": "net.mwap.app",
  "build": {
    "frontendDist": "../client/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:tauri --prefix client",
    "beforeBuildCommand": "npm run build:tauri --prefix client"
  },
  "app": {
    "windows": [
      {
        "title": "MWAPNET",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; media-src 'self' blob:; connect-src 'self' https: wss:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
